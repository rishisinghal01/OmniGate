generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  teamName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive        Boolean  @default(true)
  rateLimit       Int      @default(100) // requests allowed
  rateLimitWindow Int      @default(60)  // per this many seconds
}

model RequestLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  model     String
  latency   Int
  status    Int
  teamName  String
  cacheHit  Boolean  @default(false)
}
